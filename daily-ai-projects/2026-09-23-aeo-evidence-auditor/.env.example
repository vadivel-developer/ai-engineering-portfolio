# Which reasoning backend the LLM agents use.
#   demo   = deterministic heuristics, no model (default, used for the public demo)
#   ollama = a local model served by Ollama (free, runs on your machine)
AEO_LLM_PROVIDER=demo

# Ollama settings (only read when AEO_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
AEO_LLM_TIMEOUT_SECONDS=90
AEO_LLM_MAX_RETRIES=2
AEO_MAX_LLM_CALLS=40

# Live crawling of real websites. Off by default: the bundled sample site is always available.
# Leave this false on any public deployment (prevents the server being used as a crawler proxy).
AEO_LIVE_CRAWL_ENABLED=false
AEO_MAX_PAGES=25
AEO_FETCH_TIMEOUT_SECONDS=10
AEO_MAX_PAGE_BYTES=1500000
AEO_RUN_DEADLINE_SECONDS=600

# Server
AEO_HOST=127.0.0.1
AEO_PORT=8765
AEO_LOG_LEVEL=INFO
